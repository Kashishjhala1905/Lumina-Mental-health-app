# ---- Core ----
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/lumina

# Long random string used to sign session tokens (required in production)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Encrypts sensitive victim-support free text at rest (comments, counselor notes, AI evidence).
# Losing or changing this key makes previously encrypted text unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# Browser origin(s) allowed to call the API with credentials (comma separated)
CLIENT_URL=http://localhost:5173

# Cookie settings. Use COOKIE_SAMESITE=none only if the frontend and API are on different sites.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# ---- AI (Groq) – server-side only, never exposed to the browser ----
GROQ_API_KEY=your_api_key_here
GROQ_RETRY_COUNT=1
# Groq retires models over time; override here if the default stops working
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
# GROQ_ANALYSIS_TIMEOUT_MS=12000

# ---- Reminders ----
REMINDERS_ENABLED=true
# Centralised scheduler frequency (UTC cron expression)
REMINDER_CRON=*/15 * * * *

# Serverless deployments only (e.g. Vercel): the in-process scheduler cannot run there.
# Set CRON_SECRET and schedule GET /api/internal/cron/reminders (every 15 min) and
# GET /api/internal/cron/retention (daily) with header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---- Email (backend only – never put these in client/.env) ----
# Provider: smtp | resend | outbox (development only: writes to server/.dev-outbox, never sends) | none
# If EMAIL_PROVIDER is empty, Lumina uses Resend when RESEND_API_KEY is set, otherwise SMTP when EMAIL_HOST is set.
EMAIL_PROVIDER=smtp
# Sender shown to recipients – must be a sender/domain verified with your provider
EMAIL_FROM=Lumina <no-reply@your-domain.example>
# Public URL of the web app (also used for CORS above). Password reset links point here:
#   <CLIENT_URL>/#/reset-password?token=...   (production must use https:// and never localhost)
# APP_BASE_URL=https://your-app.example   # optional override if it differs from CLIENT_URL

# SMTP (Brevo example: EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_USER=<your Brevo SMTP login>,
#       EMAIL_PASSWORD=<your Brevo SMTP key>; Gmail: smtp.gmail.com, 587, your address, an App Password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# true for port 465 (implicit TLS); leave empty for 587 (STARTTLS)
EMAIL_SECURE=
EMAIL_REQUIRE_TLS=true
# (SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SECURE are accepted as aliases)

# Resend (HTTPS API alternative – https://resend.com)
RESEND_API_KEY=
# Optional delivery confirmation webhook → https://<api-host>/api/email/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Optional public URL of the logo for API providers (SMTP embeds the logo inline automatically)
# EMAIL_LOGO_URL=https://your-app.example/images/lumina-logo.png

# Inbox that receives a notification for every submitted feedback (rating, category, note – no user identity)
FEEDBACK_NOTIFICATION_EMAIL=feedback-inbox@your-domain.example
# Show the fictional demo counsellor profiles (always labelled "Demo profile"). Set to false in production.
DEMO_COUNSELLORS_ENABLED=true

# Delivery behaviour
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
# Password reset link lifetime (5-60 minutes)
PASSWORD_RESET_TTL_MINUTES=15

# ---- Privacy / retention ----
# Days to keep data retained after consent withdrawal before automatic purge
VS_RETENTION_DAYS=365
# Aggregates covering fewer people than this are suppressed in admin analytics
ANALYTICS_MIN_GROUP_SIZE=5

# ---- Rate limits (requests per window) ----
# API_RATE_LIMIT=600
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=20
# CHATBOT_RATE_LIMIT=20
# FORGOT_PASSWORD_RATE_LIMIT=5
# RESET_PASSWORD_RATE_LIMIT=10
# CHECKIN_RATE_LIMIT=12

# ---- Demo seed (scripts/seedDemo.js) ----
# DEMO_PASSWORD=choose_a_demo_password
